# --- Base de datos (usuario de aplicación: sin permisos de DDL) ---
DATABASE_URL=postgres://cotizador_app:CAMBIAR@localhost:5432/cotizador
DB_POOL_MAX=10
# off (local) | no-verify (Supabase en el MVP) | verify (con DB_SSL_CA = certificado raíz en PEM, saltos de línea como \n)
DB_SSL=off
# DB_SSL_CA=
ZONA_NEGOCIO=America/La_Paz

# --- Servidor ---
PORT=3000
NODE_ENV=production
CORS_ORIGINS=https://cotizador.interno.bisa.example
TRUST_PROXY=1
RATE_LIMIT_POR_MINUTO=120

# --- PDF de propuestas (Chromium) ---
# local = Chromium instalado (CHROMIUM_PATH); serverless = Chromium liviano para Vercel
PDF_MODO=local
# CHROMIUM_PATH=/usr/bin/chromium
# CHROMIUM_SIN_SANDBOX=false

# --- Autenticación: proveedor OIDC corporativo (pendiente de definir con TI) ---
AUTH_MODE=oidc
OIDC_ISSUER=https://login.ejemplo.com/tenant/v2.0
OIDC_AUDIENCE=api://cotizador-bisa
OIDC_JWKS_URI=https://login.ejemplo.com/tenant/discovery/keys
OIDC_EMAIL_CLAIM=email

# --- Solo desarrollo local (AUTH_MODE=dev). La API se niega a arrancar así en producción. ---
# AUTH_MODE=dev
# AUTH_DEV_SECRET=una-clave-larga-de-al-menos-32-caracteres
