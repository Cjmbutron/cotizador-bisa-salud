{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
"buildCommand": "npm run build && mkdir -p public && echo \"API del cotizador\" > public/index.html",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1769,
      "includeFiles": "apps/api/plantillas/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.js" }]
}
